# Template only - put real values into your environment / secret store (e.g. Coolify secrets), never into git.
# Copy to an untracked file (.env is gitignored). Leave values empty here.
ICLOUD_USER=
ICLOUD_APP_PASSWORD=          # app-specific password from appleid.apple.com (NOT the Apple ID password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- safety switches (defaults keep the app inert/read-only) ---
CALSYNC_ALLOW_WRITES=0        # 1 = allow seed/live remote writes (also needs fresh backup + approved manifest)
CALSYNC_INTERVAL=300          # scheduler period in seconds (minimum 60)
# --- alerting (any/all) ---
ALERT_WEBHOOK_URL=            # e.g. ntfy.sh topic URL or Gotify/Slack-compatible webhook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# --- backups (public age recipient ONLY; private key stays off-host) ---
CALSYNC_BACKUP_AGE_RECIPIENTS=    # age1... (comma/space separated)
CALSYNC_BACKUP_REMOTE=            # rclone remote:path (e.g. offsite:calsync); auth via RCLONE_CONFIG_<NAME>_* env, see docs/BACKUP-RESTORE.md
CALSYNC_BACKUP_LOCAL_DIR=         # mounted external backend (alternative to rclone)
CALSYNC_BACKUP_HOUR_UTC=3
# --- misc ---
TZ=UTC                        # IANA zone for the container, e.g. Europe/Berlin
CALSYNC_TIMEZONE=             # optional: zone for calendars created via `calsync create-calendar` (default: TZ, else UTC)
CALSYNC_HEALTH_BIND=127.0.0.1 # health endpoint bind address (loopback by default; nothing is published)
CALSYNC_HEALTH_STATUS=0       # 1 = serve /status also on a non-loopback bind (not recommended)
